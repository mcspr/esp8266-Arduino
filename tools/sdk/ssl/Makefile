# tools/sdk/ssl
PWD := $(shell pwd)

# tools/sdk/lib
LIB := $(addprefix $(dir $(PWD)),lib)

# tools/sdk/include/bearssl
INC := $(addprefix $(dir $(PWD)),include/bearssl)

INSTALL := install -m 644

CONF ?= esp8266

.PHONY: all T0 clean

all T0 clean: bearssl/.git
	$(MAKE) -C bearssl ARFLAGS=cDr CONF=$(CONF) $@

# repo constructs a single archive
BUILD_BEARSSL := bearssl/esp8266/libbearssl.a

# install to lib path and remove unneeded objects
LIB_BEARSSL := $(LIB)/libbearssl.a

$(LIB_BEARSSL): AR=xtensa-lx106-elf-ar
$(LIB_BEARSSL): $(BUILD_BEARSSL)
	$(INSTALL) $< $@
	symbols=$$($(AR) t $@ | grep -E 'i31|i32|x86|sse|pwr8|i62|m31|m32|m62|m64|ct64|ctmul64'); \
		( test -z "$$symbols" || ( $(AR) d $@ $$symbols ); )

VER_H := $(addprefix $(INC)/,bearssl_git.h)
$(VER_H): bearssl/.git
	{ echo "// Do not edit -- Automatically generated by tools/sdk/ssl/bearssl/Makefile"; \
	  echo "#pragma once" ; \
	  echo "#define BEARSSL_GIT $$(cd bearssl && git rev-parse --short HEAD)"; } > $@

# bearssl recipes do not provide make install
.PHONY: install

install:
	rm -vf $(LIB_BEARSSL)
	$(MAKE) $(LIB_BEARSSL)
	rm -vf $(VER_H)
	$(MAKE) $(VER_H)
	find $(INC) -name 'bearssl*.h' -delete
	find bearssl/inc -name 'bearssl*.h' -exec $(INSTALL) {} $(INC) \;

bearssl/.git:
	git submodule update --init --recursive bearssl
	test -r $@

merge-upstream:
	git submodule update --recursive --remote bearssl
